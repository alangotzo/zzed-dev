---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = "alangotzo",
  description = "Alan — Backend Engineer. Go, Python, IAM. Cordoba.",
  lang = "en",
} = Astro.props;

// Obtener la base para GitHub Pages (/zzed-dev/ o /)
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

// URL absoluta para las imágenes de Open Graph (Twitter / LinkedIn)
const ogImageUrl = new URL(`${baseUrl}avatar.jpg`, Astro.site).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Alan Fernandez",
  "url": "https://alangotzo.dev",
  "email": "naisykes6@gmail.com",
  "telephone": "+541127704818",
  "jobTitle": "Backend Engineer",
  "description": "Desarrollador web",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Cordoba",
    "addressCountry": "🇦🇷"
  },
  "sameAs": [
    "https://github.com/alangotzo",
    "https://www.linkedin.com/in/alan-fernandez-a2a113322/"
  ],
  "knowsAbout": ["Go", "Python", "IAM", "OAuth2", "Microservices", "Backend Engineering", "GCP", "AWS"]
};
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Alan Fernandez" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="200" />
    <meta property="og:image:height" content="200" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Noto+Color+Emoji&display=swap"
      rel="stylesheet"
    />
    <link rel="alternate" hreflang="en" href="https://alangotzo.dev/" />
    <link rel="alternate" hreflang="es" href="https://alangotzo.dev/es/" />
    <link rel="alternate" hreflang="x-default" href="https://alangotzo.dev/" />

    <!-- Favicons con ruta base dinámica -->
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${baseUrl}favicon.ico`} />

    <title>{title}</title>
    <!-- Anti-FOUC: apply saved theme + remove no-js class before first paint -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme') || 'dark';
        const isLight = saved === 'light' ||
          (saved === 'system' && window.matchMedia('(prefers-color-scheme: light)').matches);
        if (isLight) document.documentElement.classList.add('light');
        document.documentElement.classList.remove('no-js');
      })();
    </script>
  </head>
  <body class="min-h-screen font-mono antialiased">
    <slot />
  </body>
</html>
