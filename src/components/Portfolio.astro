<script define:vars={scriptVars}>
  // ── Mobile menu ──
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  menuToggle && menuToggle.addEventListener('click', function() {
    mobileMenu && mobileMenu.classList.toggle('hidden');
  });
  mobileMenu && mobileMenu.querySelectorAll('a').forEach(function(link) {
    link.addEventListener('click', function() { mobileMenu.classList.add('hidden'); });
  });

  // ── Theme toggle ──
  const toggle    = document.getElementById('theme-toggle');
  const iconSun   = document.getElementById('icon-sun');
  const iconMoon  = document.getElementById('icon-moon');
  const iconAuto  = document.getElementById('icon-auto');
  const CYCLE = ['dark', 'light', 'system'];

  function resolveLight(mode) {
    if (mode === 'light')  return true;
    if (mode === 'system') return window.matchMedia('(prefers-color-scheme: light)').matches;
    return false;
  }

  function updateIcons(mode) {
    if (iconMoon) iconMoon.style.display = mode === 'dark'   ? 'block' : 'none';
    if (iconSun)  iconSun.style.display  = mode === 'light'  ? 'block' : 'none';
    if (iconAuto) iconAuto.style.display = mode === 'system' ? 'inline' : 'none';
  }

  function applyMode(mode) {
    document.documentElement.classList.toggle('light', resolveLight(mode));
    localStorage.setItem('theme', mode);
    updateIcons(mode);
  }

  const savedMode = localStorage.getItem('theme') || 'dark';
  updateIcons(savedMode);

  toggle && toggle.addEventListener('click', function() {
    const current = localStorage.getItem('theme') || 'dark';
    const next = CYCLE[(CYCLE.indexOf(current) + 1) % CYCLE.length];
    applyMode(next);
  });

  window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', function(e) {
    if (localStorage.getItem('theme') === 'system') {
      document.documentElement.classList.toggle('light', e.matches);
    }
  });
  
  function setupEmailCopy() {
    const emailBtn = document.getElementById('copy-email-btn');
    const emailText = document.getElementById('email-text');

    if (emailBtn && emailText) {
      emailBtn.addEventListener('click', async () => {
        const email = emailBtn.getAttribute('data-email');
        const originalText = emailText.textContent;

        if (!email) return;

        try {
          await navigator.clipboard.writeText(email);
          emailText.textContent = '¡Copiado!';
          
          setTimeout(() => {
            emailText.textContent = originalText;
          }, 2000);
        } catch (err) {
          console.error('Error al copiar:', err);
        }
      });
    }
  }

  setupEmailCopy();
  document.addEventListener('astro:after-swap', setupEmailCopy);
  // ── Typing animation ──
  const el = document.getElementById('role-text');
  let roleIdx = 0;
  let charIdx = 0;
  let deleting = false;
  let pauseFrames = 0;

  function type() {
    if (!el) return;
    const current = ROLES[roleIdx];
    if (pauseFrames > 0) { pauseFrames--; setTimeout(type, 50); return; }
    if (!deleting) {
      el.textContent = current.slice(0, charIdx + 1);
      charIdx++;
      if (charIdx === current.length) { deleting = true; pauseFrames = 40; }
      setTimeout(type, 70);
    } else {
      el.textContent = current.slice(0, charIdx - 1);
      charIdx--;
      if (charIdx === 0) { deleting = false; roleIdx = (roleIdx + 1) % ROLES.length; pauseFrames = 5; }
      setTimeout(type, 35);
    }
  }
  setTimeout(type, 800);

  // ── Scramble hero name ──
  const nameEl = document.getElementById('hero-name');
  if (nameEl) {
    const finalText = nameEl.textContent || '';
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#$%';
    let frame = 0;
    const totalFrames = 18;
    const scramble = function() {
      if (frame >= totalFrames) { nameEl.textContent = finalText; return; }
      const progress = frame / totalFrames;
      nameEl.textContent = finalText.split('').map(function(c, i) {
        if (c === ' ') return ' ';
        if (i / finalText.length < progress) return c;
        return chars[Math.floor(Math.random() * chars.length)];
      }).join('');
      frame++;
      requestAnimationFrame(scramble);
    };
    setTimeout(function() { requestAnimationFrame(scramble); }, 100);
  }

//Last.fm
function timeAgo(ms) {
    const diff = Date.now() - ms;
    const m = Math.floor(diff / 60000);
    const h = Math.floor(m / 60);
    const d = Math.floor(h / 24);
    if (d > 0) return d + 'd';
    if (h > 0) return h + 'h';
    if (m > 0) return m + 'm';
    return 'ahora';
  }

  async function fetchNowPlaying() {
    const widget = document.getElementById('lastfm-widget');
    if (!widget) return;

    // Leemos los valores renderizados en el HTML
    const user = widget.dataset.user;
    const key = widget.dataset.key;

    if (!key || key === 'undefined' || !user || user === 'undefined') {
      console.warn('Last.fm: Falta usuario o API key');
      return;
    }

    try {
      const res = await fetch(`https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=${encodeURIComponent(user)}&api_key=${encodeURIComponent(key)}&format=json&limit=1`);
      if (!res.ok) return;

      const data = await res.json();
      const track = data?.recenttracks?.track?.[0];
      if (!track) return;

      const isNowPlaying = track['@attr'] && track['@attr'].nowplaying === 'true';
      const name = track.name || '—';
      const artist = (track.artist && track.artist['#text']) || '—';

      let artUrl = '';
      if (Array.isArray(track.image)) {
        const imgObj = track.image.find(i => i.size === 'extralarge' && i['#text']) ||
                       track.image.find(i => i.size === 'large' && i['#text']) ||
                       track.image.find(i => i.size === 'medium' && i['#text']) ||
                       track.image.find(i => i['#text']);
        if (imgObj) artUrl = imgObj['#text'];
      }

      const dot = document.getElementById('lfm-status-dot');
      const status = document.getElementById('lfm-status-text');
      const trackEl = document.getElementById('lfm-track');
      const artistEl = document.getElementById('lfm-artist');
      const artEl = document.getElementById('lfm-art');
      const placeholder = document.getElementById('lfm-art-placeholder');

      if (trackEl) trackEl.textContent = name;
      if (artistEl) artistEl.textContent = artist;

      if (artUrl && artUrl.trim() !== '' && artEl) {
        artEl.src = artUrl;
        artEl.style.display = 'block';
        if (placeholder) placeholder.style.display = 'none';
      } else {
        if (artEl) artEl.style.display = 'none';
        if (placeholder) placeholder.style.display = 'flex';
      }

      if (isNowPlaying) {
        if (dot) {
          dot.style.background = '#1db954';
          dot.style.animation = 'pulse-dot 1.5s ease-in-out infinite';
        }
        if (status) {
          status.textContent = 'REPRODUCIENDO';
          status.style.color = '#1db954';
        }
      } else {
        const ts = track.date && track.date.uts ? parseInt(track.date.uts) * 1000 : null;
        const ago = ts ? timeAgo(ts) : 'ahora';

        if (dot) {
          dot.style.background = 'var(--muted)';
          dot.style.animation = 'none';
        }
        if (status) {
          status.textContent = `HACE ${ago.toUpperCase()}`;
          status.style.color = 'var(--tag-color)';
        }
      }
    } catch(e) {
      console.error('Error al actualizar Last.fm:', e);
    }
  }

  // Inicialización
  fetchNowPlaying();
  setInterval(fetchNowPlaying, 10000);

  // ── Live Argentina clock ──
  function updateClock() {
    const el = document.getElementById('arg-clock');
    if (!el) return;
    
    const t = new Date().toLocaleTimeString(CLOCK_LOCALE || 'es-AR', {
      timeZone: 'America/Argentina/Cordoba', // o 'America/Argentina/Buenos_Aires'
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    });
    
    el.textContent = CLOCK_LABEL + ' · ' + t + ' GMT-3';
  }
  
  updateClock();
  setInterval(updateClock, 1000);
</script>
