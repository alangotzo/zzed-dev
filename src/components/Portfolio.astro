---
import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from "../i18n/translations";
import {
 siHtml5, siJavascript, siPython, siTypescript,
  siGooglecloud, siTerraform, siVault,  siMysql, 
  siClaude, siClaudecode, siGooglegemini, 
   siWhatsapp, 
} from 'simple-icons';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];

const LASTFM_USER = import.meta.env.PUBLIC_LASTFM_USER ?? "dumbhell";
const LASTFM_KEY  = import.meta.env.PUBLIC_LASTFM_API_KEY ?? "5e93d78dc4ec6cf704eee85b27015f8e";

const iconMap: Record<string, string> = {
  'Python':         siPython.path,
  'TypeScript':     siTypescript.path,
  'GCP':            siGooglecloud.path,
  'Terraform':      siTerraform.path,
  'Vault':          siVault.path,
  'MySQL':          siMysql.path,
  'Claude':         siClaude.path,
  'Gemini':         siGooglegemini.path,
  'WhatsApp API':   siWhatsapp.path,
  'HTML':           siHtml5.path,
  'JavaScript':     siJavascript.path,
};

const experience = [
  {
    company: "Freelance",
    client: " ",
    role: lang === 'es' ? "Desarrollador Web" : "Software Developer",
    period: "Apr 2026 — present",
    active: true,
    desc: t.experienceDesc[0],
    tags: ["Javascript", "Astro", "Git"],
  },
  {
    company: "Your company",
    client: "You",
    role: lang === 'es' ? "Proxima experiencia en espera..." : "Next experience waiting...",
    period: "2026",
    active: false,
    desc: t.experienceDesc[1],
    tags: ["Python", "SQL", "API","IA","Software"],
  },

];

const projects = [
  {
    name: "Frich",
    emoji: "🍔",
    desc: t.projectDesc[0],
    url: "https://github.com/alangotzo/frich-page",
    tags: ["Astro", "JavaScript", "HTML"],
    accent: "#00ff88",
  },
  {
    name: "API Backend",
    emoji: "🤖",
    desc: t.projectDesc[1],
    url: "https://github.com/alangotzo/proyect-api",
    tags: ["Python", "Flask", "SQLite3"],
    accent: "#00d9ff",
  },
  {
    name: "En desarrollo...",
    emoji: "💻",
    desc: t.projectDesc[2],
    url: "https://github.com/alangotzo",
    tags: ["...", "...", "..."],
    accent: "#a78bfa",
  },

];

const stack = [
  { label: "Python",         cls: "python",icon: siPython.path       },
  { label: "TypeScript",     cls: "ts",    icon: siTypescript.path   },
  { label: "HTML", cls: "html", icon: siHtml5.path },
  { label: "CSS", cls: "css", icon: null },
  { label: "JavaScript", cls: "js", icon: siJavascript.path },
  { label: "SQL",            cls: "db",    icon: null                },
  { label: "GitHub", cls: "infra", icon: null                        },
  { label: "SQLite3",     cls: "db",    icon: null                   },
  { label: "MySQL",          cls: "db",    icon: siMysql.path        },
  { label: "Claude",         cls: "ai",    icon: siClaude.path       },
  { label: "Gemini",         cls: "ai",    icon: siGooglegemini.path },
  { label: "ChatGPT",         cls: "ai",    icon: null               },
];

// Pass i18n vars to client script
const scriptVars = {
  ROLES: t.roles,
  LFM_LOADING: t.lfm.loading,
  LFM_NOW_PLAYING: t.lfm.nowPlaying,
  LANG: lang,
  TIME_D: t.time.d,
  TIME_H: t.time.h,
  TIME_M: t.time.m,
  TIME_NOW: t.time.now,
  CLOCK_LABEL: t.clock.label,
  CLOCK_LOCALE: t.clock.locale,
  LFM_LAST_PLAYED_ES: lang === 'es',
};
---

<Layout
  title={t.meta.title}
  description={t.meta.description}
  lang={lang}
>
  <div class="bg-grid min-h-screen">
    <div class="hero-glow"></div>

    <!-- Nav -->
    <nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-sm" style="background: var(--nav-bg); border-bottom: 1px solid var(--nav-border);">
      <div class="flex justify-between items-center px-4 md:px-8 py-4">
        <span class="text-xs tracking-widest font-bold" style="color: var(--accent);">zzed<span style="color: var(--muted);">.dev</span></span>
        <div class="flex gap-3 md:gap-6 items-center">
          <a href="#experience" class="nav-link hidden sm:inline">{t.nav.exp}</a>
          <a href="#projects"   class="nav-link hidden sm:inline">{t.nav.projects}</a>
          <a href="#stack"      class="nav-link hidden sm:inline">{t.nav.stack}</a>
          <a href="#uses"       class="nav-link hidden sm:inline">{t.nav.uses}</a>
          <a href="#interests"  class="nav-link hidden sm:inline">{t.nav.interests}</a>
          <a href="/cv.pdf" target="_blank" class="nav-link hidden sm:inline">{t.nav.cv}</a>
          <a href="mailto:hi@gabotachak.dev" class="nav-link hidden sm:inline" style="color: var(--accent);">{t.nav.contact}</a>
          <!-- Lang switcher -->
          <a href={t.nav.langSwitchHref} class="nav-link text-[10px] tracking-widest border px-1.5 py-0.5 rounded" style="border-color: var(--border); color: var(--dim);" title={lang === 'en' ? 'Versión en español' : 'English version'}>{t.nav.langSwitch}</a>
          <button id="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
            <svg id="icon-moon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <svg id="icon-sun" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <span id="icon-auto" style="display:none; font-size:10px; letter-spacing:0.05em;">auto</span>
          </button>
          <!-- Hamburger (mobile only) -->
          <button id="menu-toggle" class="sm:hidden flex flex-col gap-[4px] p-1" aria-label="Toggle menu">
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
          </button>
        </div>
      </div>
      <!-- Mobile menu -->
      <div id="mobile-menu" class="sm:hidden hidden px-4 pb-4 flex flex-col gap-3">
        <a href="#experience" class="nav-link mobile-nav-link">{t.nav.exp}</a>
        <a href="#projects"   class="nav-link mobile-nav-link">{t.nav.projects}</a>
        <a href="#stack"      class="nav-link mobile-nav-link">{t.nav.stack}</a>
        <a href="#uses"       class="nav-link mobile-nav-link">{t.nav.uses}</a>
        <a href="#interests"  class="nav-link mobile-nav-link">{t.nav.interests}</a>
        <a href="/cv.pdf" target="_blank" class="nav-link mobile-nav-link">{t.nav.cv}</a>
        <a href="naisykes6@gmail.com" class="nav-link mobile-nav-link" style="color: var(--accent);">{t.nav.contact}</a>
      </div>
    </nav>

    <!-- Hero -->
    <section class="relative z-10 max-w-4xl mx-auto px-4 md:px-8 pt-36 pb-24">
      <div class="flex flex-col md:flex-row items-start md:items-center gap-8 md:gap-10">

      <!-- Avatar -->
      <div class="avatar-ring flex-shrink-0 self-start md:self-auto">
        <img
          src={`${import.meta.env.BASE_URL}/avatar.jpg`}
          alt="Alan Fernandez"
          width="150" 
          height="150"
          style="border-radius:50%; display:block; position:relative; z-index:1; object-fit: cover;"
        >
      </div>

        <!-- Text -->
        <div class="flex-1">
          <div class="inline-flex items-center gap-2 text-[10px] tracking-[0.18em] uppercase mb-4 px-2.5 py-1 rounded-sm" style="color: var(--dim); border: 1px solid var(--border); background: var(--surface);">
            <span style="color: var(--accent);">✓</span> {t.hero.badge}
          </div>

          <h1 id="hero-name" class="text-4xl md:text-5xl font-bold mb-2 tracking-tight" style="letter-spacing:-0.5px; color: var(--text);">
            Alan Fernandez
          </h1>

          <div class="flex items-center gap-3 mb-5" style="height:28px;">
            <span style="color: var(--accent); opacity:0.5; font-size:14px;">~/</span>
            <span id="role-text" class="cursor text-lg font-medium" style="color: var(--accent); min-width:220px; font-family: var(--font), 'Noto Color Emoji';"></span>
          </div>

          <p class="text-sm leading-relaxed mb-3 max-w-lg" style="color: var(--hero-subdesc);">
            {t.hero.bio}
          </p>
          <p class="text-xs mb-6" style="color: var(--dim); font-family: var(--font), 'Noto Color Emoji';">
            {t.hero.location}
          </p>

          <!-- Row 1: profile links -->
          <div class="flex flex-wrap gap-4 text-xs mb-3 items-center">
            <a href="https://github.com/alangotzo" target="_blank" class="nav-link flex items-center gap-1.5">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              github
            </a>

            <a href="https://www.linkedin.com/in/alan-fernandez-a2a113322/" target="_blank" class="nav-link flex items-center gap-1.5">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              linkedin
            </a>

            <!-- Botón de Email formateado como link -->
            <button 
              type="button" 
              id="copy-email-btn" 
              data-email="naisykes6@gmail.com" 
              class="nav-link flex items-center gap-1.5 cursor-pointer bg-transparent border-0 p-0 text-inherit font-inherit"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <span id="email-text">naisykes6@gmail.com</span>
            </button>

            <a href="/cv.pdf" target="_blank" class="nav-link flex items-center gap-1.5">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
              {t.nav.cv}
            </a>
          </div>

          <!-- Row 2: direct contact -->
          <div class="flex flex-wrap gap-3 text-xs items-center">
            <span class="text-[10px] tracking-widest uppercase" style="color: var(--muted);">contact</span>
            <a href="tel:+541127704818" class="hero-contact-chip">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1 19.79 19.79 0 0 1 1.61 4.56 2 2 0 0 1 3.6 2.36h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.1 6.1l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span class="whitespace-nowrap">+54 11 2770-4818</span>
            </a>
            <a href="https://wa.me/541127704818" target="_blank" class="hero-contact-chip" style="color: #25d366;">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d={siWhatsapp.path}/></svg>
              WhatsApp
            </a>
            
            <!-- Redirección para Save Contact -->
            <a href="https://www.instagram.com/zzed.dev" target="_blank" rel="noopener noreferrer" class="hero-contact-chip" style="color: var(--accent);">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <span class="whitespace-nowrap">{t.hero.saveContact}</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="relative z-10 max-w-4xl mx-auto px-4 md:px-8 pb-24 reveal">
      <div class="section-label">{t.sections.experience}</div>

      <div class="relative pl-8">
        <div class="timeline-line"></div>

        <div class="space-y-10">
          {experience.map((job) => (
            <div class="relative flex gap-6 items-start">
              <div class={`timeline-dot ${job.active ? '' : 'inactive'}`} style="flex-shrink:0; margin-top:2px;"></div>
              <div class="flex-1 min-w-0">
                <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                  <div>
                    <span class="font-semibold text-sm" style="color: var(--text);">{job.role}</span>
                    <span style="color: var(--exp-at);"> @ </span>
                    <span class="text-sm" style="color: var(--accent);">{job.company}</span>
                    {job.client && <span class="text-xs" style="color: var(--tag-color);"> · {job.client}</span>}
                    {job.active && <span class="ml-2 text-[10px] px-1.5 py-0.5 rounded" style="background: var(--badge-bg); color: var(--accent); border: 1px solid var(--badge-border);">{t.experience.activeBadge}</span>}
                  </div>
                  <span class="text-xs shrink-0" style="color: var(--exp-period); font-family:inherit;">{job.period}</span>
                </div>
                <p class="text-xs leading-relaxed mb-3" style="color: var(--exp-desc);">{job.desc}</p>
                <div class="flex flex-wrap gap-1.5">
                  {job.tags.map(tag => (
                    <span class="text-[10px] px-2 py-0.5 rounded inline-flex items-center gap-1" style="background: var(--tag-bg); color: var(--tag-color); border: 1px solid var(--tag-border);">
                      {iconMap[tag] && (
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0; opacity:0.8;">
                          <path d={iconMap[tag]}/>
                        </svg>
                      )}
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="relative z-10 max-w-4xl mx-auto px-4 md:px-8 pb-24 reveal">
      <div class="section-label">{t.sections.projects}</div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {projects.map((p) => (
          <a href={p.url} target="_blank" class="project-card group" style={`--card-accent: ${p.accent};`}>
            <div class="flex items-start justify-between mb-3">
              <span class="text-lg">{p.emoji}</span>
              <svg class="opacity-0 group-hover:opacity-100 transition-opacity" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </div>
            <h3 class="text-sm font-semibold mb-2 group-hover:text-[var(--card-accent)] transition-colors font-mono" style="color: var(--text);">{p.name}</h3>
            <p class="text-xs leading-relaxed mb-3" style="color: var(--project-desc);">{p.desc}</p>
            <div class="flex flex-wrap gap-1">
              {p.tags.map(tag => (
                <span class="text-[10px] px-1.5 py-0.5 rounded inline-flex items-center gap-1" style="background: var(--project-tag-bg); color: var(--project-tag-color); border: 1px solid var(--project-tag-border);">
                  {iconMap[tag] && (
                    <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0; opacity:0.8;">
                      <path d={iconMap[tag]}/>
                    </svg>
                  )}
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Stack -->
    <section id="stack" class="relative z-10 max-w-4xl mx-auto px-4 md:px-8 pb-32 reveal">
      <div class="section-label">{t.sections.stack}</div>

      <div class="flex flex-wrap gap-2">
        {stack.map(s => (
          <span class={`chip ${s.cls}`}>
            {s.icon && (
              <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;">
                <path d={s.icon}/>
              </svg>
            )}
            {s.label}
          </span>
        ))}
      </div>
    </section>

    <!-- Uses -->
    <section id="uses" class="relative z-10 max-w-4xl mx-auto px-4 md:px-8 pb-24 reveal">
      <div class="section-label">{t.sections.uses}</div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">



<!-- PC -->
<div class="uses-card max-w-md mx-auto mb-6">
  <div class="flex items-center justify-center gap-3 mb-4">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;opacity:0.7;">
      <rect x="2" y="3" width="20" height="13" rx="2"/><path d="M8 21h8M12 16v5"/>
    </svg>
    <div>
      <div class="text-xs font-semibold" style="color:var(--text);">Desktop</div>
    </div>
  </div>
  <div>
    <div class="spec-row">
      <span class="spec-key flex items-center gap-1">
        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="2" y="2" width="12" height="12" rx="1.5"/><rect x="5" y="5" width="6" height="6" rx="0.5"/><line x1="5.5" y1="0" x2="5.5" y2="2"/><line x1="10.5" y1="0" x2="10.5" y2="2"/><line x1="5.5" y1="14" x2="5.5" y2="16"/><line x1="10.5" y1="14" x2="10.5" y2="16"/><line x1="0" y1="5.5" x2="2" y2="5.5"/><line x1="0" y1="10.5" x2="2" y2="10.5"/><line x1="14" y1="5.5" x2="16" y2="5.5"/><line x1="14" y1="10.5" x2="16" y2="10.5"/></svg>
        cpu
      </span>
      <span class="spec-val">Intel Core i3 9gen</span>
    </div>
    <div class="spec-row">
      <span class="spec-key flex items-center gap-1">
        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="1" y="4" width="14" height="8" rx="1"/><rect x="3" y="6" width="2" height="4" rx="0.5"/><rect x="7" y="6" width="2" height="4" rx="0.5"/><line x1="11" y1="6" x2="13" y2="6"/><line x1="11" y1="8" x2="13" y2="8"/><line x1="11" y1="10" x2="13" y2="10"/></svg>
        gpu
      </span>
      <span class="spec-val">Nvidia GeForce GTX 1050 Ti</span>
    </div>
    <div class="spec-row">
      <span class="spec-key flex items-center gap-1">
        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="1" y="5" width="14" height="6" rx="1"/><line x1="4" y1="5" x2="4" y2="11"/><line x1="8" y1="5" x2="8" y2="11"/><line x1="12" y1="5" x2="12" y2="11"/><line x1="4" y1="3" x2="4" y2="5"/><line x1="8" y1="3" x2="8" y2="5"/><line x1="12" y1="3" x2="12" y2="5"/></svg>
        ram
      </span>
      <span class="spec-val">16 GB DDR4</span>
    </div>
    <div class="spec-row">
      <span class="spec-key flex items-center gap-1">
